# Base de donnees PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=genidoc_hayat
DB_USER=postgres
DB_PASSWORD=your_password

# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5000,http://127.0.0.1:5000,https://localhost,capacitor://localhost
MOBILE_APP_ENABLED=false

# Secrets
JWT_SECRET=change_this_in_production
SESSION_SECRET=change_this_in_production

# Storage
STORAGE_PATH=./storage/documents
STORAGE_ENCRYPTION_KEY=change_this_32_bytes_minimum

# First official platform admin
GENIDOC_ADMIN_EMAIL=owner@your-domain.com
GENIDOC_ADMIN_PASSWORD=change_this_long_password
GENIDOC_ADMIN_FIRST_NAME=Owner
GENIDOC_ADMIN_LAST_NAME=GeniDoc
