# ========================
# GENIDOC SECURITY CONFIGURATION
# ========================
# ⚠️  NE JAMAIS commiter ce fichier avec des valeurs réelles en production
# ⚠️  NEVER commit this file with real values in production

# ========================
# NODE ENVIRONMENT
# ========================
NODE_ENV=production

# ========================
# SERVER CONFIGURATION
# ========================
PORT=5000

# ========================
# DATABASE CONFIGURATION
# ========================
# Utilise des identifiants forts et uniques par environnement
DB_HOST=localhost
DB_PORT=5432
DB_NAME=genidoc_prod
DB_USER=genidoc_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_MIN_32_CHARS_abcdef1234567890
DB_POOL_MIN=2
DB_POOL_MAX=10

# ========================
# SECURITY SECRETS
# ========================
# Doit contenir au moins 32 caractères en production!
# Générez avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

JWT_SECRET=CHANGE_ME_STRONG_JWT_SECRET_MIN_32_CHARS_abcdef1234567890xyz
SESSION_SECRET=CHANGE_ME_STRONG_SESSION_SECRET_MIN_32_CHARS_abcdef1234567890xyz
STORAGE_ENCRYPTION_KEY=CHANGE_ME_STRONG_ENCRYPTION_KEY_MIN_32_CHARS_abcdef1234567890xyz

# ========================
# CORS CONFIGURATION
# ========================
# Liste des domaines autorisés, séparés par des virgules
CORS_ORIGIN=https://app.genidoc.local,https://mobile.genidoc.local
FRONTEND_URL=https://app.genidoc.local

# ========================
# AUTHENTICATION
# ========================
# Token expiration
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=7d

# ========================
# RATE LIMITING
# ========================
# Nombre de requêtes autorisées
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ========================
# CSP (Content Security Policy)
# ========================
CSP_REPORT_URI=https://api.genidoc.local/api/security/csp-report

# ========================
# LOGGING
# ========================
LOG_LEVEL=info
LOG_FILE=/var/log/genidoc/app.log

# ========================
# EMAIL CONFIGURATION (Optional)
# ========================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@genidoc.local
SMTP_PASSWORD=CHANGE_ME_EMAIL_PASSWORD
SMTP_FROM=GeniDoc <noreply@genidoc.local>

# ========================
# EXTERNAL SERVICES
# ========================
# Clés API sécurisées
OPENWEATHER_API_KEY=CHANGE_ME_OPENWEATHER_KEY
SENTRY_DSN=https://CHANGE_ME_SENTRY_KEY@sentry.io/PROJECT_ID

# ========================
# SECURITY HEADERS
# ========================
# Ajouter des en-têtes de sécurité personnalisés
HSTS_MAX_AGE=31536000
EXPECT_CT_MAX_AGE=86400

# ========================
# FILE UPLOAD
# ========================
MAX_FILE_SIZE=10485760
UPLOAD_DIR=/var/uploads/genidoc
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,png,jpeg

# ========================
# 2FA / MFA
# ========================
TWO_FACTOR_ENABLED=true
TOTP_WINDOW=30

# ========================
# SESSION
# ========================
SESSION_TIMEOUT=3600000
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Strict

# ========================
# AUDIT LOGGING
# ========================
AUDIT_LOG_ENABLED=true
AUDIT_LOG_FILE=/var/log/genidoc/audit.log
AUDIT_LOG_RETENTION_DAYS=90

# ========================
# FEATURE FLAGS
# ========================
FEATURE_2FA=true
FEATURE_API_KEYS=false
FEATURE_OAUTH2=false

# ========================
# ADMIN FIRST USER (DEV ONLY - Change in production!)
# ========================
GENIDOC_ADMIN_EMAIL=a.senhaji@genidochayat.ma
GENIDOC_ADMIN_PASSWORD=CHANGE_ME_LONG_PASSWORD_MIN_16_CHARS
GENIDOC_ADMIN_FIRST_NAME=Owner
GENIDOC_ADMIN_LAST_NAME=GeniDoc
