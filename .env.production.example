NODE_ENV=production
PORT=5000

PUBLIC_APP_URL=https://app.genidoc.example
FRONTEND_URL=https://app.genidoc.example
CORS_ORIGIN=https://app.genidoc.example
MOBILE_APP_ENABLED=true

DB_HOST=postgres.internal
DB_PORT=5432
DB_NAME=genidoc_hayat
DB_USER=genidoc_app
DB_PASSWORD=replace_with_vault_secret

JWT_SECRET=replace_with_64_random_chars_minimum
SESSION_SECRET=replace_with_64_random_chars_minimum

STORAGE_PROVIDER=local
STORAGE_PATH=/srv/genidoc/storage/documents
STORAGE_ENCRYPTION_KEY=replace_with_32_bytes_minimum_from_vault

BACKUP_DIR=/srv/genidoc/backups

PLATFORM_OWNER_EMAIL=anas.senhaji@your-domain.com
PLATFORM_OWNER_PASSWORD=replace_with_final_strong_password
PLATFORM_OWNER_FIRST_NAME=SENHAJI
PLATFORM_OWNER_LAST_NAME=Anas
